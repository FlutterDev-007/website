# Public site URL — used for canonical URLs, sitemap and social share tags.
NEXT_PUBLIC_SITE_URL=https://fietra.com

# ── Demo request delivery (configure at least one in production) ──
# Option A: JSON webhook (Zapier, Make, Google Apps Script → Sheets, Slack, CRM)
DEMO_WEBHOOK_URL=

# Option B: email via Resend (https://resend.com)
RESEND_API_KEY=
DEMO_NOTIFY_EMAIL=sales@your-domain.com
# Must be on a domain verified in Resend; defaults to Resend's test sender.
DEMO_FROM_EMAIL="Fietra Website <noreply@your-domain.com>"
